# =====================================================================
#  SECRETS - never commit these
# =====================================================================
# git does NOT accept a comment after a pattern: the '#' only starts a
# comment at the beginning of the line, so 'data/keystore.json  # ...' was
# a pattern that matched nothing (verified with git check-ignore).  The two
# files were saved only by the data/ and *.key rules further down; written
# properly they are excluded by their own name as well.
# API keys of Anthropic and fal.ai, in clear:
data/keystore.json
# signs the session cookies:
data/secret.key
*.key
*.pem
.env
.env.*

# =====================================================================
#  PERSONAL DATA - photographs of real people and their measurements
#
#  The whole data/ tree is other people's private imagery: reference
#  photographs, generated results, thumbnails, identity profiles and the
#  account database.  None of it belongs in a repository, and once pushed
#  it cannot be taken back.  input/ and sample/ are the client's own
#  photographs and are excluded for the same reason.
# =====================================================================
data/
input/
sample/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Images anywhere outside the app's own interface assets
*.jpg
*.jpeg
*.heic
*.heif
!frontend/icons/*.png
!frontend/assets/**

# =====================================================================
#  Python
# =====================================================================
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =====================================================================
#  Editors and operating system
# =====================================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =====================================================================
#  Local scratch
# =====================================================================
*.log
logs/
tmp/
